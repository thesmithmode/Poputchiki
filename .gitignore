# Только секреты и runtime data volumes — всё остальное коммитим (правило проекта).
# node_modules — исключение: платформо-специфичные бинарники (biome, bun) ломают Linux CI.
# bun.lock обеспечивает reproducibility вместо коммита node_modules.
node_modules/
.env
.env.local
.env.*.local
.env.prod
*.pem
*.key
secrets/

# Runtime data внутри проекта (см. CLAUDE.md, договорено 2026-05-01)
.docker-data/
backups/*.dump
backups/*.dump.zst
backups/*.dump.zst.gpg
backups/wal/
backups/base-*

# Coverage reports — generated artifacts, меняются каждый CI run
coverage/
coverage-integration/

# Python bytecode
__pycache__/
*.pyc

# Local AI memory runtime artifacts: logs/state/session transcript extracts may contain
# developer-local paths, session ids, pasted secrets, PII, or production diagnostics.
.memory/scripts/*.log
.memory/scripts/flush-context-*.md
.memory/scripts/session-flush-*.md
.memory/scripts/last-flush.json
.memory/scripts/state.json

# Claude Code tool artifacts
skills-lock.json
.claude/scratch/

# Отдельный проект, хранится только локально
saas/
